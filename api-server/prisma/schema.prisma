generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === ENUMS ===
enum UserRole {
  client
  freelancer
  both
  admin
}

enum UserLevel {
  new
  rising
  top
  pro
}

enum KycStatus {
  none
  pending
  approved
  rejected
}

enum GigStatus {
  draft
  pending_review
  active
  paused
  banned
}

enum OrderStatus {
  pending
  active
  delivered
  completed
  cancelled
  disputed
  archived
}

enum TransactionType {
  deposit
  withdraw
  escrow_create
  escrow_release
  escrow_refund
  fee
  sim_topup
  promotion
  pro_subscription
  referral_bonus
}

enum TransactionStatus {
  pending
  processing
  completed
  failed
}

enum Currency {
  TON
  MANAT
}

enum PaymentStatus {
  pending
  approved
  rejected
}

enum DisputeStatus {
  open
  resolving
  resolved
  cancelled
}

enum DisputeResolution {
  none
  buyer_wins
  seller_wins
  split
}

enum TonEventType {
  escrow_created
  escrow_confirmed
  escrow_disputed
  escrow_released
  escrow_refunded
}

enum WalletVersion {
  v4R2
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum WithdrawalStatus {
  pending
  processing
  completed
  rejected
}

enum TenderStatus {
  open
  in_progress
  completed
  cancelled
  expired
}

enum ConversationType {
  direct
  order
  tender
}

enum SubscriptionTier {
  free
  pro
  business
}

enum NotificationChannel {
  telegram
  email
  push
  in_app
}

// === MODELS ===

model User {
  id                    Int       @id @default(autoincrement())
  telegramId            BigInt?   @unique
  telegramChatId        BigInt?   @unique
  email                 String?   @unique
  username              String    @unique
  displayName           String?
  avatarUrl             String?
  bio                   String?
  role                  UserRole  @default(client)
  skills                String[]  @default([])
  portfolioUrls         String[]  @default([])
  languages             String[]  @default(["ru"])
  country               String    @default("TM")
  level                 UserLevel @default(new)
  rating                Float     @default(0)
  completedOrders       Int       @default(0)
  totalRevenue          Decimal   @default(0) @db.Decimal(12, 2)
  isVerified            Boolean   @default(false)
  kycStatus             KycStatus @default(none)
  onboardingCompleted   Boolean   @default(false)
  notificationsEnabled  Boolean   @default(true)
  emailNotifications    Boolean   @default(true)
  isBanned              Boolean   @default(false)
  banReason             String?
  bannedUntil           DateTime?
  subscriptionTier      SubscriptionTier @default(free)
  subscriptionExpiresAt DateTime?
  referralCode          String?   @unique
  referredById          Int?
  referralEarnings      Decimal   @default(0) @db.Decimal(12, 2)
  lastActiveAt          DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  wallet            Wallet?
  gigs              Gig[]         @relation("GigSeller")
  ordersAsBuyer     Order[]       @relation("OrderBuyer")
  ordersAsSeller    Order[]       @relation("OrderSeller")
  messages          Message[]
  transactions      Transaction[]
  disputesInitiated Dispute[]     @relation("DisputeInitiator")
  disputesResolved  Dispute[]     @relation("DisputeResolver")
  payments          Payment[]
  favorites         Favorite[]
  reviewsGiven      Review[]      @relation("ReviewAuthor")
  reviewsReceived   Review[]      @relation("ReviewTarget")
  sessions          UserSession[]
  notifications     Notification[]
  conversations     ConversationParticipant[]
  sentMessages      ChatMessage[]
  tenders           Tender[]      @relation("TenderAuthor")
  tenderBids        TenderBid[]
  portfolioItems    PortfolioItem[]
  withdrawals       WithdrawalRequest[]
  referredBy        User?         @relation("Referral", fields: [referredById], references: [id])
  referrals         User[]        @relation("Referral")
  analytics         SellerAnalytics?

  @@map("users")
}

model Wallet {
  id                  Int           @id @default(autoincrement())
  userId              Int           @unique
  address             String        @unique
  publicKey           String
  encryptedMnemonic     String?
  encryptedPrivateKey   String?
  version             WalletVersion @default(v4R2)
  balanceNano         BigInt        @default(0)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  gigCount    Int      @default(0)
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())

  gigs    Gig[]
  tenders Tender[]

  @@map("categories")
}

model Gig {
  id            Int        @id @default(autoincrement())
  sellerId      Int
  categoryId    Int
  title         String
  description   String     @db.Text
  price         Decimal    @db.Decimal(12, 2)
  deliveryDays  Int        @default(3)
  revisions     Int        @default(1)
  status        GigStatus  @default(pending_review)
  tags          String[]   @default([])
  images        String[]   @default([])
  rating        Float      @default(0)
  reviewCount   Int        @default(0)
  orderCount    Int        @default(0)
  isFeatured    Boolean    @default(false)
  isPromoted    Boolean    @default(false)
  promotedUntil DateTime?
  promotedRank  Int?
  views         Int        @default(0)
  clicks        Int        @default(0)
  conversionRate Float      @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  seller     User           @relation("GigSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id])
  orders     Order[]
  reviews    Review[]
  favorites  Favorite[]
  extras     GigExtra[]
  packages   GigPackage[]

  @@index([status, categoryId])
  @@index([sellerId])
  @@index([isFeatured, status])
  @@index([isPromoted, promotedUntil])
  @@map("gigs")
}

model GigExtra {
  id          Int      @id @default(autoincrement())
  gigId       Int
  title       String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  deliveryDays Int     @default(0)
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@map("gig_extras")
}

model GigPackage {
  id           Int      @id @default(autoincrement())
  gigId        Int
  name         String   // "Basic", "Standard", "Premium"
  description  String?  @db.Text
  price        Decimal  @db.Decimal(12, 2)
  deliveryDays Int      @default(3)
  revisions    Int      @default(1)
  includes     String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@map("gig_packages")
}

model Order {
  id                Int         @id @default(autoincrement())
  gigId             Int?        // null for tender-originated orders (S1-3)
  tenderId          Int?        // set when order was created from a tender bid (S1-3)
  buyerId           Int
  sellerId          Int
  packageId         Int?        // если выбран пакет
  status            OrderStatus @default(pending)
  totalPrice        Decimal     @db.Decimal(12, 2)
  quantity          Int         @default(1)
  requirements      String?     @db.Text
  deliveryDays      Int         @default(3)
  escrowAddress     String?
  tonTransactionHash String?
  completedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  gig      Gig?      @relation(fields: [gigId], references: [id], onDelete: Restrict)
  tender   Tender?   @relation("TenderOrders", fields: [tenderId], references: [id], onDelete: SetNull)
  buyer    User      @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  package  GigPackage? @relation(fields: [packageId], references: [id])
  messages Message[]
  items    OrderItem[]
  dispute  Dispute?
  review   Review?

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([escrowAddress])
  @@index([tenderId])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  extraId   Int
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  order Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  extra GigExtra @relation(fields: [extraId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Message {
  id          Int       @id @default(autoincrement())
  orderId     Int
  senderId    Int
  content     String    @db.Text
  attachments String[]  @default([])
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("messages")
}

model ChatMessage {
  id              Int      @id @default(autoincrement())
  conversationId  Int
  senderId        Int
  content         String   @db.Text
  attachments     String[] @default([])
  isQuickReply    Boolean  @default(false)
  quickReplyName  String?
  readAt          DateTime?
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model Conversation {
  id          Int             @id @default(autoincrement())
  type        ConversationType @default(direct)
  orderId     Int?
  tenderId    Int?
  lastMessageAt DateTime      @default(now())
  createdAt   DateTime        @default(now())

  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@map("conversations")
}

model ConversationParticipant {
  id              Int      @id @default(autoincrement())
  conversationId  Int
  userId          Int
  lastReadAt      DateTime?
  isMuted         Boolean  @default(false)
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Tender {
  id            Int         @id @default(autoincrement())
  authorId      Int
  categoryId    Int
  title         String
  description   String      @db.Text
  budgetMin     Decimal?    @db.Decimal(12, 2)
  budgetMax     Decimal?    @db.Decimal(12, 2)
  currency      Currency    @default(MANAT)
  status        TenderStatus @default(open)
  deadlineDays  Int         @default(7)
  skills        String[]    @default([])
  attachments   String[]    @default([])
  assignedToId  Int?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  author     User        @relation("TenderAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id])
  bids       TenderBid[]
  orders     Order[]     @relation("TenderOrders")
  assignedTo User?       @relation(fields: [assignedToId], references: [id])

  @@map("tenders")
}

model TenderBid {
  id          Int      @id @default(autoincrement())
  tenderId    Int
  freelancerId Int
  price       Decimal  @db.Decimal(12, 2)
  message     String?  @db.Text
  deliveryDays Int     @default(3)
  isSelected  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tender       Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  freelancer   User   @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([tenderId, freelancerId])
  @@map("tender_bids")
}

model PortfolioItem {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?  @db.Text
  imageUrls   String[] @default([])
  videoUrl    String?
  categoryId  Int?
  tags        String[] @default([])
  linkUrl     String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("portfolio_items")
}

model Transaction {
  id          Int               @id @default(autoincrement())
  userId      Int
  type        TransactionType
  status      TransactionStatus @default(pending)
  amountNano  BigInt            @default(0)
  currency    Currency          @default(TON)
  metadata    Json?
  txHash      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([txHash])
  @@map("transactions")
}

model Payment {
  id            Int           @id @default(autoincrement())
  userId        Int
  amountManat   Decimal       @db.Decimal(12, 2)
  screenshotUrl String?
  status        PaymentStatus @default(pending)
  note          String?
  reviewedById  Int?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer   User? @relation("PaymentReviewer", fields: [reviewedById], references: [id])

  @@map("payments")
}

model WithdrawalRequest {
  id            Int              @id @default(autoincrement())
  userId        Int
  amountNano    BigInt
  currency      Currency         @default(TON)
  destination   String           // wallet address or bank card
  destinationType String         @default("ton_wallet")
  status        WithdrawalStatus @default(pending)
  txHash        String?
  reviewedById  Int?
  reviewedAt    DateTime?
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawal_requests")
}

model Dispute {
  id          Int               @id @default(autoincrement())
  orderId     Int               @unique
  initiatorId Int
  reason      String            @db.Text
  status      DisputeStatus     @default(open)
  resolution  DisputeResolution @default(none)
  resolvedById Int?
  evidence    Json?
  createdAt   DateTime          @default(now())
  resolvedAt  DateTime?

  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  initiator User   @relation("DisputeInitiator", fields: [initiatorId], references: [id])
  resolver  User?  @relation("DisputeResolver", fields: [resolvedById], references: [id])

  @@map("disputes")
}

model Review {
  id          Int          @id @default(autoincrement())
  orderId     Int          @unique
  gigId       Int
  authorId    Int
  targetId    Int
  rating      Int
  comment     String?      @db.Text
  status      ReviewStatus @default(pending)
  createdAt   DateTime     @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gig    Gig   @relation(fields: [gigId], references: [id], onDelete: Cascade)
  author User  @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target User  @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  gigId     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gig  Gig  @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([userId, gigId])
  @@map("favorites")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    Int
  tokenHash String
  jti       String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String   @db.Text
  data      Json?
  channel   NotificationChannel @default(in_app)
  read      Boolean  @default(false)
  sentAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model PromoCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  type        String   // percent | fixed
  value       Decimal  @db.Decimal(12, 2)
  maxUses     Int      @default(1)
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("promocodes")
}

model Referral {
  id              Int      @id @default(autoincrement())
  referrerId      Int
  referredId      Int      @unique
  status          String   @default("pending") // pending | completed | paid
  bonusEarnedNano BigInt   @default(0)
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([referrerId, referredId])
  @@map("referrals")
}

model SellerAnalytics {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  viewsToday        Int      @default(0)
  viewsWeek         Int      @default(0)
  viewsMonth        Int      @default(0)
  ordersToday       Int      @default(0)
  ordersWeek        Int      @default(0)
  ordersMonth       Int      @default(0)
  revenueToday      Decimal  @default(0) @db.Decimal(12, 2)
  revenueWeek       Decimal  @default(0) @db.Decimal(12, 2)
  revenueMonth      Decimal  @default(0) @db.Decimal(12, 2)
  conversionRate    Float    @default(0)
  avgResponseHours  Float?
  lastCalculatedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_analytics")
}

model TonEvent {
  id              Int          @id @default(autoincrement())
  contractAddress  String?
  eventType       TonEventType
  payload         Json
  blockSeqno      Int?
  processed       Boolean      @default(false)
  processedAt     DateTime?
  retryCount      Int          @default(0)
  createdAt       DateTime     @default(now())

  @@index([contractAddress, processed])
  @@index([eventType, processed])
  @@map("ton_events")
}

model QuickReply {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  orderIndex Int     @default(0)
  createdAt DateTime @default(now())

  @@map("quick_replies")
}

model Webhook {
  id        String   @id @default(uuid())
  userId    Int
  url       String
  secret    String
  events    String[] @default([])
  isActive  Boolean  @default(true)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhooks")
}

model Config {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("config")
}
