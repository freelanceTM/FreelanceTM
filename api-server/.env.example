# =============================================================================
# FreelanceTM — Production Environment Configuration
# =============================================================================
# ⚠️  NEVER commit the real .env file. This is a template.
#     Copy to .env and fill with real values before first deploy.
# =============================================================================

# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=/api
# Client URL for CORS (Telegram Mini App domain or web app)
CLIENT_URL=https://app.freelancetm.io

# ── Database ───────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASS@HOST:PORT/DB?schema=public&connection_limit=20
DATABASE_URL="postgresql://postgres:CHANGEME_STRONG_PASSWORD@postgres:5432/freelancetm?schema=public&connection_limit=20"

# ── Redis (sessions, cache, Socket.IO adapter fallback) ──────────────────────
REDIS_URL=redis://redis:6379

# ── Security ───────────────────────────────────────────────────────────────
# JWT_SECRET: min 32 random chars. Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS_MINIMUM_LENGTH_REQUIRED!!
# JWT_REFRESH_SECRET: separate key for refresh tokens (optional, falls back to JWT_SECRET)
JWT_REFRESH_SECRET=

# MASTER_ENCRYPTION_KEY: 32 bytes for AES-256-GCM wallet encryption.
# Generate ONCE, backup offline (paper / hardware token / Vault).
# If lost — ALL user wallets are unrecoverable.
MASTER_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_OR_BASE64_KEY!!

# Admin panel internal secret (for internal endpoints if any)
ADMIN_SECRET=REPLACE_WITH_RANDOM_ADMIN_SECRET

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
# Webhook URL for production bot (uncomment when domain ready)
# TELEGRAM_WEBHOOK_URL=https://api.freelancetm.io/api/telegram/webhook
# Admin Telegram ID for push alerts (get from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=123456789

# ── TON Blockchain (Testnet for Beta / Mainnet for Production) ────────────
TON_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TON_API_KEY=YOUR_TONCENTER_API_KEY
# 24 words from Tonkeeper / TON wallet. NEVER commit real mnemonic to git.
PLATFORM_MNEMONIC=word1 word2 word3 ... word24
# Filled automatically after first deploy of escrow contract
PLATFORM_WALLET_ADDRESS=
ESCROW_CONTRACT_ADDRESS=

# ── AI ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY

# ── Object Storage (MinIO / AWS S3 / Selectel) ────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=freelancetm-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGEME_STRONG_S3_SECRET
S3_REGION=us-east-1
S3_USE_SSL=false

# ── Monitoring & Error Tracking ────────────────────────────────────────────
# Sentry DSN (optional but HIGHLY recommended for production)
# Get from https://sentry.io — free tier is enough for startup
SENTRY_DSN=https://xxxx@yyyy.ingest.sentry.io/zzzz
# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Limits ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── Email / SMTP (optional — for email notifications fallback) ───────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@freelancetm.io

# ── Exchange Rate API (optional — for TM CELL ↔ TON real-time rate) ─────────
# EXCHANGE_RATE_API_KEY=
