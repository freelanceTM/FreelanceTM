# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

  # Old/duplicate artifacts (cleanup)
  artifacts/freelancetm/
  artifacts/mockup-sandbox/

  # Replit internal files
  .agents/
  .replit
  .replitignore
  EOF

  # Remove from git tracking
  git rm -r --cached artifacts/freelancetm/ 2>/dev/null || true
  git rm -r --cached artifacts/mockup-sandbox/ 2>/dev/null || true
  git rm -r --cached .agents/ 2>/dev/null || true
  git rm --cached .replit 2>/dev/null || true
  git rm --cached .replitignore 2>/dev/null || true

  # Stage .gitignore
  git add .gitignore

  # Commit
  git commit -m "chore: remove junk — old artifact duplicates and Replit internals" --allow-empty

  # Push
  git push https://x-access-token:@github.com/freelanceTM/FreelanceTM.git HEAD:main

  echo "DONE"
  

# Old duplicate artifacts
artifacts/freelancetm/
artifacts/mockup-sandbox/

# Replit internals
.agents/
.replit
.replitignore
